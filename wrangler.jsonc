{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "venus-holidays",
  "main": "dist/_worker.js/index.js",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": [
    "global_fetch_strictly_public"
  ],
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "venusholidays.co", "custom_domain": true },
    { "pattern": "www.venusholidays.co", "custom_domain": true }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "dist"
  }
}
