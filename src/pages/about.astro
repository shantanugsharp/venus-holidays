---
import Base from '../layouts/Base.astro';
import { SITE, waLink } from '../data/site.js';
import ServiceGrid from '../components/ServiceGrid.astro';

const title = 'About Venus Holidays — Mumbai Tour Operator Since 2000';
const description =
  'Venus Holidays, Borivali West — a professionally managed travel company founded by Manoj Mahapadi on 17 July 2000. Domestic & international tours, group travel and complete travel solutions.';

const clients = [
  'Yerala Medical College, Kharghar', 'Saraswati College, Kharghar', 'M. D. College, Parel',
  'Parswanath College, Ghodbunder', 'N. S. D. College, Nahur', 'Tasgaonkar College, Bhivpuri',
  'Siddharth College, Churchgate', 'K. C. College, Mumbai', 'Bhavan’s College, Girgaon',
  'Sydenham College, Churchgate', 'CIDCO', 'Aakanksha Marketing Concept Pvt. Ltd.', 'Goldstar Jewellery Ltd.',
];
const partners =
  'Tarang Travels (Kalyan) · Go To Joy Holidays (Goregaon) · Go Dream Destination (Borivali) · Chinmay Tours (Dadar) · Saishraddha Travels (Chinchpokli) · Surabhi Tours (Thane) · Konkan Paryatan (Chiplun) · Sky Lab Travels (Dahisar) · Vignaharta Travels (Borivali) · Mangalmurti Travels (Dahisar) · Swastik Tours (Borivali) · Y. P. Holidays (Belapur)';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: 'About', item: new URL('/about/', Astro.site).href },
  ],
};
const aboutLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: title,
  url: new URL('/about/', Astro.site).href,
  about: { '@id': new URL('/#organization', Astro.site).href },
};
---

<Base title={title} description={description} jsonLd={[breadcrumbLd, aboutLd]}>
  <div class="page-hero">
    <div class="wrap">
      <p class="eyebrow">About us</p>
      <h1>Your trusted travel partner since 2000.</h1>
      <p>
        Our objective is simple — to make every journey comfortable, well-planned and memorable.
      </p>
    </div>
  </div>

  <section class="section">
    <div class="wrap">
      <div class="about-grid">
        <div class="about-copy">
          <p class="eyebrow">Our story</p>
          <h2>More than two decades of travel</h2>
          <p>
            <strong>Venus Holidays was founded on 17 July 2000 by Mr. Manoj Mahapadi</strong> — a
            professionally managed travel company based in Mumbai, offering complete domestic and
            international travel solutions.
          </p>
          <p>
            Our journey has been built on trust, personalised service, professional travel
            planning and long-term relationships. We cater to individual travellers, families,
            senior citizens, corporates, schools, colleges, institutions and groups.
          </p>
          <p>
            Our motto is on the door: <strong>Learn to Travel · Travel to Learn.</strong>
          </p>
        </div>
        <div class="about-points">
          <div class="point"><b>Established 17 July 2000</b><span>25+ years of travel planning and tour operations from Mumbai.</span></div>
          <div class="point"><b>Personalised service</b><span>Every traveller is different — itineraries built around your needs, dates and budget.</span></div>
          <div class="point"><b>Everything under one roof</b><span>Tickets, hotels, transport, sightseeing and visas — one office, one coordinator.</span></div>
          <div class="point"><b>Group travel expertise</b><span>Family groups, pilgrimage groups, educational tours and corporate travel.</span></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">What we do</p>
        <h2>Complete travel solutions under one roof</h2>
      </div>
      <ServiceGrid />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Our clients</p>
        <h2>Trusted by institutions across Mumbai</h2>
        <p>Organisations and institutions that have travelled with Venus Holidays over the years.</p>
      </div>
      <div class="hl-chips">
        {clients.map((c) => <span class="hl-chip">{c}</span>)}
      </div>
      <p style="font-size:.82rem;color:var(--text-soft);margin-top:22px">
        <strong style="color:var(--heading)">Travel partners:</strong> {partners}
      </p>
    </div>
  </section>

  <section class="section map-sec" style="border-bottom:0">
    <div class="wrap">
      <div class="about-grid">
        <div class="about-copy">
          <p class="eyebrow">Visit us</p>
          <h2>Chai's on us in Borivali</h2>
          <p>
            You'll find us at <strong>{SITE.address.street}, {SITE.address.locality},
            {SITE.address.city} – {SITE.address.postalCode}</strong> — Monday to Saturday
            10:00–19:30, Sunday 11:00–16:00.
          </p>
          <p>
            Can't make it to the office? No problem — we plan most trips entirely over
            <a href={waLink('Hi Venus Holidays!')} target="_blank" rel="noopener" style="color:var(--accent-deep);font-weight:600">WhatsApp</a> or a call:
            <a href={`tel:${SITE.phone2Href}`} style="color:var(--accent-deep);font-weight:600">{SITE.phone2Display}</a>.
          </p>
          <div style="display:flex;gap:14px;flex-wrap:wrap;margin-top:8px">
            <a class="btn btn-gold" href="/packages/">Browse our trips</a>
            <a class="btn btn-line" href="/contact/">Contact details →</a>
          </div>
        </div>
        <div class="about-points">
          <div class="point"><b>Proprietor</b><span>Mr. Manoj Mahapadi — leading Venus Holidays since 17 July 2000.</span></div>
          <div class="point"><b>Office</b><span>{SITE.address.street}, {SITE.address.locality}, {SITE.address.city} – {SITE.address.postalCode}</span></div>
          <div class="point"><b>Talk to us</b><span>{SITE.phone2Display} · {SITE.phoneDisplay} · {SITE.email}</span></div>
        </div>
      </div>
    </div>
  </section>
</Base>
