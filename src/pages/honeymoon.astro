---
import Base from '../layouts/Base.astro';
import packages from '../data/packages.json';
import { SITE, waLink, formatINR } from '../data/site.js';
import { HONEYMOON_DOMESTIC, HONEYMOON_INTERNATIONAL, HONEYMOON_EXTRAS } from '../data/honeymoon.js';

const title = 'Honeymoon Packages — Per Couple Pricing | Venus Holidays';
const description =
  'Customised honeymoon packages per couple — Goa from ₹29,999, Kashmir, Kerala, Andaman, Maldives, Bali, Dubai & more. Room decoration, candlelight dinners and private transfers included.';

const byId = Object.fromEntries(packages.map((p) => [p.id, p]));
const photoFor = (h) => byId[h.pkgId]?.photos?.[0] || byId[h.pkgId]?.photo;

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: 'Honeymoon Packages', item: new URL('/honeymoon/', Astro.site).href },
  ],
};
const listLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Venus Holidays honeymoon packages',
  itemListElement: [...HONEYMOON_DOMESTIC, ...HONEYMOON_INTERNATIONAL].map((h, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Product',
      name: h.name,
      offers: { '@type': 'Offer', price: h.priceINR, priceCurrency: 'INR', description: 'Per couple' },
    },
  })),
};

const waFor = (h) => waLink(`Hi Venus Holidays! We're planning our honeymoon — interested in the ${h.name} (${h.nights}N/${h.days}D). Please share details.`);
---

<Base title={title} description={description} jsonLd={[breadcrumbLd, listLd]}>
  <div class="page-hero">
    <div class="wrap">
      <p class="eyebrow">Honeymoon packages</p>
      <h1>Begin your forever journey.</h1>
      <p>
        Romantic, comfortable and built around your budget — with room decoration, candlelight
        dinners and private transfers. All prices are per couple, taxes included.
      </p>
    </div>
  </div>

  <section class="section" style="padding:56px 0">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">In India</p>
        <h2>Domestic honeymoons</h2>
      </div>
      <div class="hm-grid">
        {HONEYMOON_DOMESTIC.map((h) => (
          <article class="hm-card">
            <div class="hm-art">
              {photoFor(h) && <img src={photoFor(h)} alt={h.name} width="900" height="520" loading="lazy" decoding="async" />}
              <span class="pkg-tag">{h.nights}N / {h.days}D</span>
            </div>
            <div class="hm-body">
              <h3>{h.name}</h3>
              <div class="pkg-meta"><span>{h.places}</span></div>
              <div class="hm-inc">{h.inc.map((x) => <span>✓ {x}</span>)}</div>
              <div class="hm-foot">
                <div class="pkg-price"><span>From · per couple</span><b>{formatINR(h.priceINR)}</b></div>
                <div class="hm-links">
                  <a class="wa" href={waFor(h)} target="_blank" rel="noopener">Enquire</a>
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt" style="padding:56px 0">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Abroad</p>
        <h2>International honeymoons</h2>
      </div>
      <div class="hm-grid">
        {HONEYMOON_INTERNATIONAL.map((h) => (
          <article class="hm-card">
            <div class="hm-art">
              {photoFor(h) && <img src={photoFor(h)} alt={h.name} width="900" height="520" loading="lazy" decoding="async" />}
              <span class="pkg-tag">{h.nights}N / {h.days}D</span>
            </div>
            <div class="hm-body">
              <h3>{h.name}</h3>
              <div class="pkg-meta"><span>{h.places}</span></div>
              <div class="hm-inc">{h.inc.map((x) => <span>✓ {x}</span>)}</div>
              <div class="hm-foot">
                <div class="pkg-price"><span>From · per couple</span><b>{formatINR(h.priceINR)}</b></div>
                <div class="hm-links">
                  <a class="wa" href={waFor(h)} target="_blank" rel="noopener">Enquire</a>
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" style="padding:56px 0">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Special inclusions</p>
        <h2>The little things that make it a honeymoon</h2>
        <p>Available per the package you choose — tell us what matters to you.</p>
      </div>
      <div class="hl-chips">
        {HONEYMOON_EXTRAS.map((x) => <span class="hl-chip">{x}</span>)}
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="band">
        <div>
          <h2>Your honeymoon, your way.</h2>
          <p>Share your budget, destination, dates and hotel category — we'll craft a package just for the two of you. Luxury options: Maldives, Bali, Switzerland, Dubai, Mauritius, Seychelles.</p>
        </div>
        <a class="btn btn-wa" href={waLink("Hi Venus Holidays! We're planning our honeymoon. Please help us with a customised package.")} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2z"/></svg>
          Plan on WhatsApp
        </a>
      </div>
    </div>
  </section>
</Base>
