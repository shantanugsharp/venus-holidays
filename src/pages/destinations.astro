---
import Base from '../layouts/Base.astro';
import packages from '../data/packages.json';
import { waLink, formatINR } from '../data/site.js';
import { DESTINATION_GROUPS } from '../data/destinations.js';

const title = 'Destinations We Cover | Venus Holidays';
const description =
  'Everywhere Venus Holidays can take you — Kashmir to Kanyakumari, Char Dham to 12 Jyotirlinga, and Thailand to Europe. Set itineraries or fully customised trips from Mumbai.';

const bySlug = Object.fromEntries(packages.map((p) => [p.slug, p]));
const totalDest = DESTINATION_GROUPS.reduce((n, g) => n + g.items.length, 0);

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: 'Destinations', item: new URL('/destinations/', Astro.site).href },
  ],
};
---

<Base title={title} description={description} jsonLd={[breadcrumbLd]}>
  <div class="page-hero">
    <div class="wrap">
      <p class="eyebrow">Destinations</p>
      <h1>Where can we take you?</h1>
      <p>
        Everywhere Venus Holidays runs trips — some with ready itineraries you can book today,
        the rest planned custom around your dates.
      </p>
      <div class="proof-row" style="margin-top:22px">
        <span class="proof">{packages.length} ready itineraries</span>
        <span class="proof">{totalDest} destinations</span>
        <span class="proof">Anywhere in India on request</span>
      </div>
    </div>
  </div>

  {DESTINATION_GROUPS.map((g, gi) => {
    const withItin = g.items.filter((it) => it.slug && bySlug[it.slug]).length;
    return (
      <section class:list={['section', { 'section-alt': gi % 2 === 1 }]} style="padding:52px 0">
        <div class="wrap">
          <div class="section-head" style="margin-bottom:22px">
            <p class="eyebrow">{g.title}</p>
            <h2 style="font-size:clamp(1.4rem,2.6vw,1.9rem)">
              {g.title === 'India Holidays' ? 'The country, corner to corner' :
               g.title === 'Yatras & Pilgrimage' ? 'Darshan, planned properly' :
               g.title === 'Popular Circuits' ? 'Routes our travellers love' :
               'And the world beyond'}
            </h2>
            <p style="font-size:.9rem">{withItin} of {g.items.length} with ready itineraries — the rest planned custom on WhatsApp.</p>
          </div>
          <div class="dcard-grid">
            {g.items.map((it) => {
              const pkg = it.slug ? bySlug[it.slug] : null;
              return pkg ? (
                <a class="dcard" href={`/packages/${it.slug}/`}>
                  {pkg.photo && <img src={pkg.photo} alt={it.label} width="900" height="520" loading="lazy" decoding="async" />}
                  <span class="dcard-body">
                    <b>{it.label}</b>
                    <i>{pkg.nights}N/{pkg.days}D · from {formatINR(pkg.priceINR)}{pkg.per === 'couple' ? '/couple' : ''}</i>
                  </span>
                </a>
              ) : (
                <a class="dcard dcard-wa" href={waLink(`Hi Venus Holidays! I want a ${it.label} package. Please share details.`)} target="_blank" rel="noopener">
                  <span class="dcard-body">
                    <b>{it.label}</b>
                    <i class="wa-i">Enquire on WhatsApp ↗</i>
                  </span>
                </a>
              );
            })}
          </div>
        </div>
      </section>
    );
  })}

  <section class="section" style="padding-top:20px">
    <div class="wrap">
      <div class="band">
        <div>
          <h2>Somewhere else in mind?</h2>
          <p>We build custom trips for any destination — tell us where and when, we'll plan the rest.</p>
        </div>
        <a class="btn btn-wa" href={waLink('Hi Venus Holidays! I want a custom trip. Destination: ')} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2z"/></svg>
          Ask on WhatsApp
        </a>
      </div>
    </div>
  </section>
</Base>
